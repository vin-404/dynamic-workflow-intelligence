# SQLite is the supported database for this project (decision D-04): the
# engine cannot tell the difference and Postgres is a time sink. These are
# also the defaults in backend/app/settings.py, so an .env file is optional.
DATABASE_URL=sqlite+aiosqlite:///./dwi.db
DATABASE_URL_SYNC=sqlite:///./dwi.db
ENVIRONMENT=development

# Optional. Absent or empty selects the NullProvider, under which every P0
# capability still works (ARCHITECTURE B.3). Never commit a real key.
ANTHROPIC_API_KEY=
AI_PROVIDER=null
