# Every variable this application reads. Copy to `.env` for local overrides;
# a fresh clone runs correctly with no `.env` at all, because these are the
# defaults.
#
# For a deployment, set these in the hosting dashboard - never in a committed
# file. Nothing in this repository contains a real key, and nothing should.
#
# The backend variables are declared in `backend/app/settings.py`; a test
# fails if this file documents one that does not exist there.


# =============================================================================
# Backend
# =============================================================================

# -- Database -----------------------------------------------------------------
# SQLite by default: no server, no setup, and the engine cannot tell the
# difference (decision D-04). For a deployment where data must survive a
# restart, point this at managed Postgres instead - nothing else changes:
#
#   DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
#
# The `+asyncpg` is required. A plain postgresql:// URL fails at startup.
DATABASE_URL=sqlite+aiosqlite:///./dwi.db

# The synchronous URL, used only by tooling. Keep it pointing at the same
# database as DATABASE_URL.
DATABASE_URL_SYNC=sqlite:///./dwi.db

# -- HTTP ---------------------------------------------------------------------
# "development" or "production". Production hides exception detail from 500
# responses; everything else is identical.
ENVIRONMENT=development

# Exact origins allowed to call this API, comma-separated. A JSON array also
# works. `*` is refused at startup: this API allows credentials, and a
# wildcard with credentials is rejected by every browser - so it would look
# permissive and behave like a blocklist.
#
#   CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The port to bind. Injected by the hosting platform; the image honours it.
# Locally the backend runs on 8001, because that is what the frontend's dev
# proxy expects.
PORT=8001

# -- Bounded work -------------------------------------------------------------
# Ceilings, not targets - a seeded workflow analyzes in about 20ms. These exist
# so a pathological input returns an explained 503 instead of holding a
# connection open. Optional; the defaults below are the built-in ones.
ANALYZE_TIMEOUT_SECONDS=20
SIMULATE_TIMEOUT_SECONDS=20
OPTIMIZE_TIMEOUT_SECONDS=30

# -- Operations ---------------------------------------------------------------
# Load both demo domains on startup. Idempotent - a restart against a
# populated database writes nothing. Set false if you are pointing at a
# database you populated yourself.
SEED_ON_STARTUP=true

# Guards POST /admin/reset-seed, which drops everything and reloads both seed
# domains. **Leave empty and the endpoint is disabled**, which is the right
# default: an unguarded database reset on a public URL is an undo button for
# your demo that anyone can press. Set a long random string on a deployment
# you intend to hand to strangers.
ADMIN_TOKEN=

# -- Authentication -----------------------------------------------------------
# The shared secret between the Next.js server and this API. It is the backend
# half of a two-header handshake: the Next proxy verifies the Google session,
# then sends `X-User-Id` (who) and `X-Proxy-Secret` (proof it came from us).
# This API honours `X-User-Id` **only** when `X-Proxy-Secret` matches this
# value, which is what stops anyone calling the backend's public URL directly
# and claiming to be someone else.
#
# **Empty means the pre-auth open behaviour**, and that is deliberate: a fresh
# clone and the whole test suite run with no configuration at all. Open mode
# trusts `X-User-Id` as sent and leaves ProjectMember.role advisory.
#
# Set it and two things change together: the header pair is required, and
# roles become enforced (viewer reads and evaluates; editor authors and
# applies; owner also changes members). Must be byte-identical to the
# frontend's value below. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Note: setting this without also setting ADMIN_TOKEN disables
# POST /api/seed/reset as well as POST /admin/reset-seed.
PROXY_SHARED_SECRET=

# -- The AI layer (entirely optional) ------------------------------------------
# Absent or empty selects NullProvider, under which every capability still
# works: the Interpreter falls back to a labelled pattern matcher, the
# Narrator to the engine's own wording, and the optimizer to its deterministic
# generators. The UI says which you are looking at.
#
# Never commit a real key.
ANTHROPIC_API_KEY=

# "auto" (default) uses the key if one is present, "null" forces the offline
# path even when a key is set - which is the recommended way to demo.
AI_PROVIDER=auto


# =============================================================================
# Frontend  (frontend/.env.local, or the Vercel dashboard)
# =============================================================================

# There is deliberately **no NEXT_PUBLIC_API_URL any more.**
#
# The browser must only ever talk to the Next.js origin, because that is where
# `src/proxy.ts` verifies the session and injects the identity headers. An
# absolute backend URL in the browser bundle would send requests straight to
# FastAPI, past the session check and past the injection - the app would look
# signed-in while every request arrived anonymous, and auth would be
# decorative. `src/lib/api.ts` therefore hard-codes a relative base and reads
# no variable at all. There is nothing to misconfigure.

# The backend base URL as the **Next.js server** will reach it, read at
# runtime by `src/proxy.ts` and by the sign-in upsert. Inside Docker Compose
# it is the service name (http://api:8001) rather than localhost.
API_REWRITE_URL=http://localhost:8001

# -- Auth.js (NextAuth v5) ----------------------------------------------------
# Google sign-in runs in Next.js, not in FastAPI, so the session cookie is
# same-origin and there is no cross-origin cookie problem to solve. These four
# are required in any deployment; without them sign-in fails closed, which is
# the correct failure for a broken login.
#
# From the Google Cloud Console, with the redirect URI registered as
#   <NEXTAUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Signs and encrypts the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=

# The origin Auth.js builds callback URLs from. http://localhost:3000 locally;
# the real https:// origin in a deployment, or Google will refuse the redirect.
NEXTAUTH_URL=http://localhost:3000

# The frontend half of the handshake described above. Must equal the backend's
# PROXY_SHARED_SECRET exactly. Unset means the proxy still enforces sign-in at
# Next and still sends `X-User-Id`, but sends no proof - so the backend must
# also be in open mode for identity to be trusted.
PROXY_SHARED_SECRET=

# -- The browser walkthroughs only --------------------------------------------
# `1` adds a password-free Credentials provider so `npm run e2e:all` can sign
# in - Google's consent screen cannot be driven headless. It requires
# NODE_ENV != production as well, and because Next inlines NODE_ENV at build
# time the provider **cannot exist** in a `next build` bundle. Consequence:
# the walkthroughs must run against `next dev`.
#
# Never set this in a deployment. Leave it unset and the provider is absent
# entirely, not merely hidden.
E2E_AUTH_ENABLED=
